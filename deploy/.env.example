# 复制为 .env 后按需修改：cp .env.example .env && chmod 600 .env
# 国内机器可先运行 sh detect-region.sh，自动把 KUKIE_IMAGE 换成更快的镜像源。

# 仅旧版升级：原编排使用固定项目名 kukie 时，取消下一行注释以继续管理已有容器
# 面板或 -p 指定过其他项目名时保留原名；首次部署无需设置
# COMPOSE_PROJECT_NAME=kukie

# 镜像地址。国内加速源与直连二选一：
#   海外：ghcr.io/qiuyuxc/kukie-platform:latest
#   国内：ghcr.nju.edu.cn/qiuyuxc/kukie-platform:latest
KUKIE_IMAGE=ghcr.io/qiuyuxc/kukie-platform:latest

# 可选：网站公开地址，用于固定规范链接及 IndexNow；留空时按访问地址生成页面链接
# 仅为运行时配置，更换域名不需要重新构建镜像
KUKIE_SITE_URL=

# 可选：额外允许的浏览器跨域来源。同源网站/后台和原生 App 均不需要填写
KUKIE_CONSOLE_ORIGINS=

# HTTPS 反代时保持 1（Secure Cookie 和页面 HTTPS 链接）；HTTP 直连时改为 0
KUKIE_SECURE_COOKIE=1

KUKIE_INDEXNOW_KEY=

# 监听地址与端口。默认只绑定本机，由宿主机或面板的反向代理转发
KUKIE_BIND=127.0.0.1
KUKIE_SITE_PORT=8086
KUKIE_CONSOLE_PORT=8085
KUKIE_API_PORT=8084

# 以下仅在启用 edge 配置文件（内置 Caddy）时需要
KUKIE_SITE_HOST=blog.example.com
KUKIE_CONSOLE_HOST=console.example.com
KUKIE_API_HOST=api.example.com
KUKIE_HTTP_PORT=80
KUKIE_HTTPS_PORT=443
